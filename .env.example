# agent-bridge settings. Copy to .env and fill in. Relative paths resolve against this file's folder.
# The demo (python demo.py) does not read this file.

# --- names on the board -------------------------------------------------------------------------------
# owner value for rows the PC should handle
BRIDGE_LOCAL_OWNER=PC
# the cloud agent's board name; sessions ask it questions with "ASK AGENT:"
BRIDGE_AGENT_NAME=AGENT
# IANA time zone for board stamps, for example Europe/London
BRIDGE_TZ=UTC
BRIDGE_STATE_DIR=./state
BRIDGE_INTERVAL=45
BRIDGE_MAX_SESSIONS=2
# extra allow-listed GET jobs (read-only), format as in fixtures/jobs.json; empty = built-ins only
BRIDGE_JOBS_FILE=

# --- board: json (local file), sqlite (local db) or sheets (Google Sheets) -------------------------------
BRIDGE_BOARD=sheets
BRIDGE_BOARD_PATH=
SHEET_ID=your-sheet-id
SHEET_TAB=Tasks

# --- shared folder for pulse, results and the agent's status file: local or drive -----------------------
BRIDGE_STORE=drive
BRIDGE_SHARED_DIR=
DRIVE_FOLDER_ID=your-drive-folder-id

# --- Google OAuth (Sheets + Drive scopes), only for sheets / drive --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- wake-ups for the cloud agent: log (local file) or github (a PR in a private repo, via the gh CLI) ----
BRIDGE_WAKE=github
WAKE_GITHUB_REPO=your-user/agent-wake
WAKE_GITHUB_BASE=main
WAKE_GAP_SECONDS=120

# --- the local agent: claude (Claude Code CLI, headless) or mock (scripted, no AI) ----------------------
BRIDGE_RUNNER=claude
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_WORKDIR=~/projects
# acceptEdits by default; for hard limits list the tools a session may use, for example Read,Grep,Glob,Edit,Write
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=
CLAUDE_TURN_TIMEOUT=2700

# --- how a turn is started: systemd (own transient unit, Linux), subprocess (portable) or inline --------
BRIDGE_LAUNCHER=systemd

# --- the pulse (what the PC tells the cloud agent about itself) -----------------------------------------
PULSE_EVERY_SECONDS=180
SYNC_GAP_SECONDS=1800
# Claude Code keeps transcripts and memory per project under ~/.claude/projects/<project-folder>/
PULSE_TRANSCRIPTS_DIR=~/.claude/projects/your-project-folder
PULSE_MEMORY_DIR=~/.claude/projects/your-project-folder/memory
# folders whose changed FILE NAMES are listed (never contents); comma separated
PULSE_WATCH_DIRS=~/Documents,~/Downloads
PULSE_SYSTEM_CHECKS=1
